{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/loop",
	"title": "Loop",
	"category": "marccent",
	"icon": "update",
	"description": "Repeats its item for every post of a type (posts, projects, products…), the posts related to the current one (a relation field, either way), or every row of a repeating field group (a gallery's photos, offices), in the theme's grid. Design the item once with any blocks; show the values with Field blocks, {{ tokens }} or block bindings. Loops nest: an inner Loop's current post is the outer one's item.",
	"keywords": [ "query", "posts", "list", "grid", "custom post type", "repeater", "rows" ],
	"textdomain": "marccent-content",
	"attributes": {
		"source": { "type": "string", "default": "" },
		"postType": { "type": "string", "default": "post" },
		"perPage": { "type": "number", "default": 6 },
		"orderBy": { "type": "string", "default": "date" },
		"order": { "type": "string", "default": "desc" },
		"taxonomy": { "type": "string", "default": "" },
		"terms": { "type": "string", "default": "" },
		"parent": { "type": "string", "default": "" },
		"relation": { "type": "string", "default": "" },
		"from": { "type": "string", "default": "" },
		"where": { "type": "string", "default": "" },
		"offset": { "type": "number", "default": 0 },
		"excludeCurrent": { "type": "boolean", "default": true },
		"cols": { "type": "number", "default": 3 },
		"layout": { "type": "string", "default": "" },
		"gap": { "type": "string", "default": "" },
		"empty": { "type": "string", "default": "Nothing here yet." },
		"paginate": { "type": "boolean", "default": false },
		"filters": { "type": "string", "default": "" },
		"searchBox": { "type": "boolean", "default": false }
	},
	"usesContext": [ "postId", "postType" ],
	"providesContext": { "marccent/source": "source" },
	"supports": { "html": false },
	"editorScript": "marccent-content-editor",
	"render": "file:./render.php"
}
